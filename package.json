{
  "name": "@raimshq/raims",
  "version": "0.1.4",
  "description": "Official Node.js SDK for the Raims public API.",
  "homepage": "https://docs.raims.com/en/integracoes/sdk-node",
  "repository": { "type": "git", "url": "https://github.com/raimshq/raims-node.git" },
  "bugs": { "url": "https://github.com/raimshq/raims-node/issues" },
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.cts",
  "exports": {
    ".": {
      "import": { "types": "./types/index.d.mts", "default": "./src/index.mjs" },
      "require": { "types": "./types/index.d.cts", "default": "./src/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["src/", "types/", "docs/usage.md", "docs/webhooks.md", "docs/reference.md", "README.md", "SECURITY.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "generate": "node scripts/generate.cjs",
    "check-generated": "node scripts/generate.cjs --check",
    "check-source": "node scripts/check-source.cjs",
    "check-compatibility": "node scripts/check-compatibility.cjs --check",
    "snapshot-api": "node scripts/check-compatibility.cjs --write",
    "check": "node scripts/check.cjs",
    "prepack": "npm run check"
  },
  "keywords": ["raims", "sdk", "payments", "pix", "typescript"]
}
