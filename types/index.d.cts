readonly "reason_code": number | null;
/** Valor contestado, em centavos de real. Não representa o valor atualmente bloqueado nem confirma devolução. */
readonly "disputed_amount_cents": number;
/** Data de criação do registro na Raims, em segundos Unix UTC. */
readonly "created_at": number;
/** Data da última atualização disponível, em segundos Unix UTC. */
readonly "updated_at": number;
};
